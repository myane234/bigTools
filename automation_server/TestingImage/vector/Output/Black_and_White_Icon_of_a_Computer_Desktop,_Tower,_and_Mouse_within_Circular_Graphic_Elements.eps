<x:xmpmeta xmlns:x='adobe:ns:meta/' x:xmptk='Image::ExifTool 13.53'>
<rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'>

 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A minimalist black and white illustration featuring a desktop computer monitor, a computer tower, and a mouse. These elements are centrally placed and enclosed within a dynamic circular design composed of varying thickness black strokes and shapes, suggesting motion or data flow. The background is pure white, emphasizing the graphic nature of the icon.</rdf:li>
   </rdf:Alt>
  </dc:description>
