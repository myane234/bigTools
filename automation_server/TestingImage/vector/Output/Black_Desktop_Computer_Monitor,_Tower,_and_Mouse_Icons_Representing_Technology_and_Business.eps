 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A minimalist black icon set featuring a desktop computer monitor, a computer tower, and a computer mouse, all on a white background. The monitor is screen-focused, the tower stands upright with visible indicator lights, and the mouse is positioned beside them, symbolizing essential components of personal computing and modern technology.</rdf:li>
   </rdf:Alt>
  </dc:description>
  <dc:subject>
