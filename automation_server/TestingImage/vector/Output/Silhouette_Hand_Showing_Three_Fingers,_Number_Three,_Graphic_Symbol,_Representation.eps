 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A black silhouette of a hand is shown against a white background. Three fingers, specifically the index, middle, and ring fingers, are extended upwards, while the thumb and pinky finger are curled inwards. The image is a simple, graphic representation of the number three using a hand gesture.</rdf:li>
   </rdf:Alt>
  </dc:description>
