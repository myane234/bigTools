<x:xmpmeta xmlns:x='adobe:ns:meta/' x:xmptk='Image::ExifTool 13.53'>
<rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'>

 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A minimalist, geometric illustration of three rectangular blocks stacked on top of each other, with a slight offset creating a sense of depth. The blocks are solid black with rounded edges, set against a pure white background. This design evokes concepts of construction, data, or modularity.</rdf:li>
   </rdf:Alt>
  </dc:description>
  <dc:subject>
   <rdf:Bag>
    <rdf:li>block</rdf:li>
    <rdf:li>stack</rdf:li>
