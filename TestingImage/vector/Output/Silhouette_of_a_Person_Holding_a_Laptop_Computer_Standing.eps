 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A full-body silhouette of a person standing against a white background. The person is wearing casual clothing, including a hooded jacket and trousers, and is holding a laptop computer in their hands. The silhouette is solid black, emphasizing the form and shape of the individual and the device.</rdf:li>
   </rdf:Alt>
  </dc:description>
