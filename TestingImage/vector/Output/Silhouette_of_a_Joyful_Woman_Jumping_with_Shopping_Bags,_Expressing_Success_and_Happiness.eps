  </dc:subject>
  <dc:title>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>Silhouette of a Joyful Woman Jumping with Shopping Bags, Expressing Success and Happiness</rdf:li>
   </rdf:Alt>
  </dc:title>
 </rdf:Description>

