<x:xmpmeta xmlns:x='adobe:ns:meta/' x:xmptk='Image::ExifTool 13.53'>
<rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'>

 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A black silhouette of a woman is captured mid-jump against a plain white background. Her right arm is raised high in a gesture of triumph, while her left hand clutches two shopping bags. Her legs are bent, conveying a sense of energetic movement and exhilaration. The silhouette highlights her dynamic pose and the excitement associated with shopping and achievement.</rdf:li>
   </rdf:Alt>
  </dc:description>
  <dc:subject>
