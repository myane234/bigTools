  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A black silhouette of a young person lying on their stomach, propped up on their elbows and typing on a laptop. Their legs are bent and raised in the air. The background is a solid white.</rdf:li>
   </rdf:Alt>
