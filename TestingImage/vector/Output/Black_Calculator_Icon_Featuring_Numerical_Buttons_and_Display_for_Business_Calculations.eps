<x:xmpmeta xmlns:x='adobe:ns:meta/' x:xmptk='Image::ExifTool 13.53'>
<rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'>

 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A simple, solid black icon of a calculator is depicted against a white background. The calculator features a grid of square buttons, representing numerical inputs and functions. At the top, there is a rectangular display screen with two small rectangular indicators, suggesting it is ready for input or calculation. The device is shown at a slight angle, giving it a dynamic feel.</rdf:li>
   </rdf:Alt>
  </dc:description>
