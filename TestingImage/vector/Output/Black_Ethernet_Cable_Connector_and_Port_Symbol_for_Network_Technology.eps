<?xpacket begin='﻿' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x='adobe:ns:meta/' x:xmptk='Image::ExifTool 13.53'>
<rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'>

 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>A clean, black silhouette graphic shows two components of an ethernet connection: an RJ45 connector plug and its corresponding socket port. The plug, on the left, features the typical rectangular head with vertical pins visible within. Below the plug head is a slightly curved cable. The port, on the right, is presented as a square outline with the internal pin structure visible, and it also has a curved cable extending downwards.</rdf:li>
   </rdf:Alt>
  </dc:description>
  <dc:subject>
   <rdf:Bag>
    <rdf:li>ethernet</rdf:li>
    <rdf:li>cable</rdf:li>
    <rdf:li>connector</rdf:li>
