  <dc:title>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>Diverse Business Professionals in Silhouette Standing Together, Representing Teamwork and Corporate Success</rdf:li>
   </rdf:Alt>
  </dc:title>
 </rdf:Description>

